# ---------- Database (pgvector via docker compose) ----------
POSTGRES_USER=edukonic
POSTGRES_PASSWORD=edukonic
POSTGRES_DB=edukonic
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://edukonic:edukonic@localhost:5432/edukonic

# ---------- LLM & Embeddings ----------
# Generation & Validation (Google AI Studio key: https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEN_MODEL=gemini-flash-lite-latest
VALIDATE_MODEL=gemini-flash-lite-latest

# Embeddings: local (sentence-transformers) or gemini
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
EMBED_BATCH_SIZE=32

LLM_CONCURRENCY=2
LLM_MAX_RETRIES=6

# ---------- Chunking ----------
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=480
CHUNK_OVERLAP_TOKENS=40

# ---------- Generation ----------
DEDUPE_THRESHOLD=0.80
RETRIEVAL_NEIGHBORS=3

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Teacher login for the demo (simple shared password; replaced by ERP SSO later)
APP_PASSWORD=change-me
