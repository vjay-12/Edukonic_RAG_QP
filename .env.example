# ---------- Database (pgvector via docker compose) ----------
POSTGRES_USER=edukonic
POSTGRES_PASSWORD=edukonic
POSTGRES_DB=edukonic
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://edukonic:edukonic@localhost:5432/edukonic

# ---------- LLM (Google AI Studio key: https://aistudio.google.com -> Get API key) ----------
GEMINI_API_KEY=
# Model names change over time: confirm in AI Studio / Gemini API docs
GEN_MODEL=gemini-2.5-flash
VALIDATE_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
# Embedding size. If you change EMBED_MODEL/EMBED_DIM you must re-embed (make reset-db && make ingest)
EMBED_DIM=768
LLM_CONCURRENCY=2
LLM_MAX_RETRIES=6

# ---------- Chunking ----------
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=650
CHUNK_OVERLAP_TOKENS=50

# ---------- Generation ----------
DEDUPE_THRESHOLD=0.88
RETRIEVAL_NEIGHBORS=3

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Teacher login for the demo (simple shared password; replaced by ERP SSO later)
APP_PASSWORD=change-me
